# Só precisa disso pra rodar no seu PC. No GitHub, os valores vão em
# Settings > Secrets and variables > Actions.

# App da Twitch: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Bot do Telegram (@BotFather). Mande /start pro bot antes da primeira rodada.
TELEGRAM_BOT_TOKEN=
# Opcional: descoberto sozinho pelo /start
TELEGRAM_CHAT_ID=

# ---- Ajustes (tudo opcional, esses são os padrões) ----
GAME_NAME=Grand Theft Auto VI
# Idiomas das lives: pt,en | all = todos
LANGUAGES=pt,en
# Idioma que ganha prioridade na ordem (none = nenhum) e o tamanho do empurrão
BOOST_LANG=pt
BOOST=3
LOOKBACK_HOURS=6
MIN_VIEWS=50
MAX_DURATION=60
CLIPS_PER_RUN=3
# Máximo de clipes do mesmo streamer por rodada (0 = sem limite)
MAX_PER_STREAMER=1
INTERVAL_MIN=10
HASHTAGS=#GTA6 #GTAVI #GTA6Brasil #gta #twitch #clips
# Fonte pro crédito escrito no vídeo (vazio = sem texto no vídeo)
# Windows: C:/Windows/Fonts/arialbd.ttf
FONT_FILE=
